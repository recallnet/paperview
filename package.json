{
  "name": "paperview",
  "private": true,
  "version": "0.0.0",
  "description": "Local literature-review tooling and corpus workflows for strategy discovery.",
  "scripts": {
    "codecontext:scope": "codecontext --scope",
    "codecontext:diff": "codecontext --diff HEAD",
    "codecontext:report": "codecontext --report",
    "codecontext:py": "uv run --with-editable ../codecontext/packages/python codecontext-python",
    "store:init": "python3 scripts/init_local_store.py",
    "store:load-metadata": "python3 scripts/load_metadata_store.py",
    "store:reconcile-canonical": "python3 scripts/reconcile_canonical_store.py",
    "store:materialize-corpus-memberships": "uv run --with pyyaml python3 scripts/materialize_corpus_memberships.py",
    "store:materialize-text-views": "python3 scripts/materialize_text_views.py",
    "store:materialize-view-embeddings": "python3 scripts/materialize_view_embeddings.py",
    "store:materialize-knn": "python3 scripts/materialize_knn_edges.py",
    "store:materialize-clusters": "python3 scripts/materialize_clusters.py",
    "store:materialize-probes": "python3 scripts/materialize_probes.py",
    "store:materialize-transition-state-scores": "python3 scripts/materialize_transition_state_scores.py",
    "store:materialize-transition-state-candidates": "python3 scripts/materialize_transition_state_candidates.py",
    "store:materialize-stranded-resurfacing-candidates": "python3 scripts/materialize_stranded_resurfacing_candidates.py",
    "store:materialize-bridges": "uv run --with numpy --with pyyaml --with sqlite-vec python3 scripts/materialize_bridges.py",
    "store:materialize-compositions": "uv run --with numpy --with pyyaml --with sqlite-vec python3 scripts/materialize_compositions.py",
    "store:materialize-contrasts": "python3 scripts/materialize_contrasts.py",
    "store:materialize-negative-space": "uv run --with numpy --with pyyaml --with sqlite-vec python3 scripts/materialize_negative_space.py",
    "store:materialize-review-packets": "python3 scripts/materialize_review_packets.py",
    "store:materialize-shortlist": "python3 scripts/materialize_shortlist.py",
    "store:materialize-selective-interpretation-batch": "python3 scripts/materialize_selective_interpretation_batch.py",
    "store:ingest-selective-interpretations": "python3 scripts/ingest_selective_interpretations.py",
    "store:ingest-enhanced-interpretations": "python3 scripts/ingest_enhanced_interpretations.py",
    "store:materialize-holdout-echoes": "uv run --with sqlite-vec python3 scripts/materialize_holdout_echoes.py",
    "store:materialize-unrealized-ideas-index": "python3 scripts/materialize_unrealized_ideas_index.py",
    "store:materialize-stranded-result-ledger": "python3 scripts/materialize_stranded_result_ledger.py",
    "store:materialize-findings-and-throwaways": "python3 scripts/materialize_findings_and_throwaways.py",
    "store:materialize-transition-state-ledger": "python3 scripts/materialize_transition_state_ledger.py",
    "store:materialize-research-output": "python3 scripts/materialize_research_output.py",
    "store:materialize-run-summary": "python3 scripts/materialize_run_summary.py",
    "store:materialize-test-memos": "python3 scripts/materialize_test_memos.py",
    "study:ds1-translation-gap": "uv run --with pyyaml python3 scripts/materialize_ds1_translation_gap.py",
    "study:ds2-bridge-zones": "python3 scripts/materialize_ds2_bridge_zones.py",
    "study:ds3-early-market-ledger": "python3 scripts/materialize_ds3_early_market_ledger.py",
    "study:ds4-stranded-ledger": "python3 scripts/materialize_ds4_stranded_ledger.py",
    "store:materialize-enhanced-interpretation-batch": "python3 scripts/materialize_enhanced_interpretation_batch.py",
    "score:materialize-stranding": "uv run --with pyyaml python3 scripts/materialize_stranding_scores.py",
    "test:unit": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "docs:lint": "recall-docs-governance lint",
    "docs:lint:changed": "recall-docs-governance lint --changed"
  },
  "devDependencies": {
    "@recallnet/codecontext-cli": "^0.3.0",
    "@recallnet/docs-governance-preset": "^0.2.2"
  }
}
